{
  "name": "@docmyrepos/ui",
  "version": "0.2.0",
  "description": "React pages and components of DocMyRepos.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dash-AI-Tools/doc-my-repos.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./styles.css": "./src/styles.css",
    "./internal/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./pages/*": {
        "types": "./dist/pages/*.d.ts",
        "default": "./dist/pages/*.js"
      },
      "./styles.css": "./dist/styles.css",
      "./internal/*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@docmyrepos/core": "workspace:*",
    "@docmyrepos/server": "workspace:*",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "mermaid": "^12.2.0",
    "next-themes": "^0.4.6",
    "swagger-ui-react": "5.33.3"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
