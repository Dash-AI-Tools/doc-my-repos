{
  "name": "@docmyrepos/server",
  "version": "0.2.0",
  "description": "Server runtime of DocMyRepos: the application factory, services, default adapters and route handlers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dash-AI-Tools/doc-my-repos.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next.ts",
    "./proxy": "./src/proxy.ts",
    "./migrate": "./src/migrate.ts",
    "./internal/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./next": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "./proxy": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      },
      "./migrate": {
        "types": "./dist/migrate.d.ts",
        "default": "./dist/migrate.js"
      },
      "./internal/*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@docmyrepos/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "^2.0.0",
    "pg": "^8.23.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "universal-github-app-jwt": "^2.2.2",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1"
  }
}
