",
    "mode": "644",
    "path": "docker-compose.yml",
  },
  {
    "content": "# Written by create-docmyrepos. This file holds secrets: keep it owner-only and never commit it.
# Portal address: http://localhost:3000
APP_PORT=3000

# Database (compose builds DATABASE_URL from these).
POSTGRES_PASSWORD='ppppppppppppppppppppppppppppppppppppppppppp'

# GitHub App (read-only).
GITHUB_APP_ID=4242
GITHUB_APP_INSTALLATION_ID=99
GITHUB_APP_PRIVATE_KEY='<PEM, \\n escaped>'
GITHUB_WEBHOOK_SECRET='wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww'

SYNC_SECRET='yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy'
SESSION_SECRET='sssssssssssssssssssssssssssssssssssssssssss'

# First administrator, created on the first sign-in while there are no users.
# Remove both lines after signing in, then run \`docker compose up -d\`.
ADMIN_EMAIL='admin@example.com'
ADMIN_PASSWORD='correct horse battery'
",
    "mode": "600",
    "path": ".env",
  },
  {
    "content": "# DocMyRepos configuration. It only narrows the repositories the GitHub App can access;
# see docmyrepos.config.example.yml in the DocMyRepos repository for every option.
repos:
  - "api"
  - "true"
  - "web.app"
",
    "mode": "644",
    "path": "docmyrepos.config.yml",
  },
  {
    "content": ".env
.env.*
*.pem
*.bak-*
",
    "mode": "644",
    "path": ".gitignore",
  },
]
