# Copy to .env and fill in. Never commit .env.
# Placeholders below are safe to leave as-is for local development
# except the GitHub values, which need a real GitHub App.

# Postgres connection used by the app and Drizzle (matches docker-compose.yml defaults).
DATABASE_URL=postgres://docmyrepos:docmyrepos@127.0.0.1:5432/docmyrepos

# Optional: server for DB-backed tests (they create and drop a throwaway database there).
# Defaults to DATABASE_URL, then to the value above. Set SKIP_DB_TESTS=1 to skip them.
# TEST_DATABASE_URL=postgres://docmyrepos:docmyrepos@127.0.0.1:5432/docmyrepos

# Optional: Postgres server for the Playwright e2e databases (`pnpm test:e2e` creates and drops
# docmyrepos_e2e_<random>_seeded and _empty there). Defaults to the value above. Set
# E2E_SKIP_DB=1 to skip the specs that need a database.
# DATABASE_URL_E2E=postgres://docmyrepos:docmyrepos@127.0.0.1:5432/docmyrepos

# Compose-only: credentials and database name for the db service.
POSTGRES_USER=docmyrepos
POSTGRES_PASSWORD=docmyrepos
POSTGRES_DB=docmyrepos
# Host port published on 127.0.0.1.
POSTGRES_PORT=5432

# GitHub App ID (numeric), from the App settings page.
GITHUB_APP_ID=
# GitHub App private key (PEM contents). Use this OR GITHUB_APP_PRIVATE_KEY_PATH.
GITHUB_APP_PRIVATE_KEY=
# Path to the App private key PEM file. Use this OR GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_PRIVATE_KEY_PATH=
# Installation ID of the App on the target org.
GITHUB_APP_INSTALLATION_ID=
# Webhook secret configured on the GitHub App; used to verify webhook signatures.
# At least 16 characters; use a long random string.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# Shared secret guarding POST /api/sync. Any long random string.
SYNC_SECRET=replace-with-sync-secret
