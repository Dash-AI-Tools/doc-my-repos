# Copy to .env and fill in. Never commit .env.
# Placeholders below are safe to leave as-is for local development
# except the GitHub values, which need a real GitHub App.

# Postgres connection used by the app and Drizzle when you run it on the host (pnpm dev,
# pnpm db:migrate). It matches the db service of docker-compose.yml, published on 127.0.0.1.
# `docker compose up` ignores it for the app container, which reaches the db service by its
# compose name instead (see APP_DATABASE_URL below).
DATABASE_URL=postgres://docmyrepos:docmyrepos@127.0.0.1:5432/docmyrepos

# Optional: server for DB-backed tests (they create and drop a throwaway database there).
# Defaults to DATABASE_URL, then to the value above. Set SKIP_DB_TESTS=1 to skip them.
# TEST_DATABASE_URL=postgres://docmyrepos:docmyrepos@127.0.0.1:5432/docmyrepos

# Optional: Postgres server for the Playwright e2e databases (`pnpm test:e2e` creates and drops
# docmyrepos_e2e_<random>_seeded and _empty there). Defaults to the value above. Set
# E2E_SKIP_DB=1 to skip the specs that need a database.
# DATABASE_URL_E2E=postgres://docmyrepos:docmyrepos@127.0.0.1:5432/docmyrepos

# Compose-only: credentials and database name for the db service.
POSTGRES_USER=docmyrepos
POSTGRES_PASSWORD=docmyrepos
POSTGRES_DB=docmyrepos
# Host port published on 127.0.0.1.
POSTGRES_PORT=5432

# Compose-only settings for the app service (all optional):
# Address and host port the app is published on. Loopback by default: put a TLS reverse proxy in
# front and leave APP_BIND alone unless the proxy runs on another machine.
# APP_BIND=127.0.0.1
# APP_PORT=3000
# Use an external database instead of the db service (remove that service and the depends_on in
# docker-compose.yml). Percent-encode special characters in the password. Connect directly or
# through a pooler in session mode, not PgBouncer in transaction mode.
# APP_DATABASE_URL=postgres://user:password@db.example.com:5432/docmyrepos
# Your copy of docmyrepos.config.example.yml, mounted read-only into the container. Default: an
# empty config (every repository the GitHub App can access). The file must exist.
# DOCMYREPOS_CONFIG=./docmyrepos.config.yml
# Skip the migrations the container applies on start (replicas of one database: let one apply them).
# SKIP_MIGRATIONS=1

# GitHub App ID (numeric), from the App settings page.
GITHUB_APP_ID=
# GitHub App private key (PEM contents). Use this OR GITHUB_APP_PRIVATE_KEY_PATH. In this file the
# key goes on one line in double quotes, with \n for each line break:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
# Path to the App private key PEM file. Use this OR GITHUB_APP_PRIVATE_KEY. In the container this
# is /run/secrets/github_app_key when you enable the compose secret (see docker-compose.yml).
GITHUB_APP_PRIVATE_KEY_PATH=
# Installation ID of the App on the target org.
GITHUB_APP_INSTALLATION_ID=
# Webhook secret configured on the GitHub App; used to verify webhook signatures.
# At least 16 characters; use a long random string (for example `openssl rand -hex 32`).
# The `replace-with-...` placeholder is REJECTED at startup: the app will not start until you change it.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# Shared secret guarding POST /api/sync. At least 16 characters; any long random string. The
# `replace-with-...` placeholder is REJECTED at startup, like the webhook secret above.
SYNC_SECRET=replace-with-sync-secret

# Optional: log threshold (debug, info, warn, error, silent). Default info. Logs are JSON lines
# on stdout (debug, info) and stderr (warn, error) and never contain secrets.
# LOG_LEVEL=info

# Optional: background sync scheduler (startup sync, periodic full sync, retries of waiting
# syncs). Default: on when NODE_ENV=production, off otherwise. 1 forces it on, 0 off.
# SYNC_SCHEDULER=1
